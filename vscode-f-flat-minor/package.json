{
  "name": "vscode-f-flat-minor",
  "displayName": "F♭m (f-flat-minor) Language Support",
  "description": "Syntax highlighting and language support for f-flat-minor, a minimal stack-oriented programming language",
  "version": "0.0.14",
  "publisher": "hypercubed",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:f-flat-minor",
    "onCommand:f-flat-minor.auditCurrentDefinition",
    "onCommand:f-flat-minor.auditDefinitionByWord",
    "onCommand:f-flat-minor.openTraceViewer",
    "onCommand:f-flat-minor.traceViewerTogglePlayback"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Hypercubed/f-flat-minor"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "sync-core-vocab": "node -e \"require('fs').copyFileSync(require('path').join('..','_shared','core-vocabulary.json'), require('path').join('src','core-vocabulary.json'))\"",
    "bundle-ers": "esbuild ../node/bin/ers.ts --bundle --platform=node --format=esm --outfile=out/ers-cli.mjs",
    "compile": "npm run sync-core-vocab && npm run bundle-ers && tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.0",
    "vsce": "^2.0.0"
  },
  "contributes": {
    "configuration": {
      "title": "F-flat-minor",
      "properties": {
        "f-flat-minor.ersScript": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the ERS entry script (`ers.ts` from the f-flat-minor repo, or a pre-bundled `ers-cli.mjs`). When empty, the extension uses its bundled CLI or searches upward from the open file / workspace folders for `node/bin/ers.ts`."
        },
        "f-flat-minor.ersOutputFormat": {
          "type": "string",
          "enum": ["text", "json"],
          "default": "text",
          "description": "ERS audit output in the output panel: plain text (same as `ers audit` without `--json`) or pretty-printed JSON (`-j`)."
        },
        "f-flat-minor.ersHover": {
          "type": "boolean",
          "default": true,
          "description": "When true, hovering a definition name (`word:`) shows ERS body, safety verdict, and reasons (runs `ers audit --word … --json`)."
        },
        "f-flat-minor.coreVocabHover": {
          "type": "boolean",
          "default": true,
          "description": "When true, hovering a core/primitive token shows mnemonic, opcode, stack effect, and description (from embedded `_shared/core-vocabulary.json`, web-inspector style)."
        },
        "f-flat-minor.execFileMaxBufferMb": {
          "type": "number",
          "default": 256,
          "minimum": 16,
          "maximum": 2048,
          "markdownDescription": "Per-stream cap (MiB) for `stdout` and `stderr` when the extension runs Node subprocesses (`ff-run`, ERS). JSONL trace output is written to stderr, so long traces can exceed small defaults. Applied separately to each stream. Increase for very long traces; lower if memory is a concern."
        },
        "f-flat-minor.traceRunTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "maximum": 3600,
          "markdownDescription": "Hard timeout in seconds for each `ff-run` subprocess launched by the trace viewer. When exceeded, the extension terminates the process and reports a timeout error."
        }
      }
    },
    "commands": [
      {
        "command": "f-flat-minor.auditCurrentDefinition",
        "title": "F-flat-minor: Audit Current Definition"
      },
      {
        "command": "f-flat-minor.auditDefinitionByWord",
        "title": "F-flat-minor: Audit Definition by Word"
      },
      {
        "command": "f-flat-minor.openTraceViewer",
        "title": "F-flat-minor: Open Trace Viewer"
      },
      {
        "command": "f-flat-minor.traceViewerTogglePlayback",
        "title": "F-flat-minor: Trace Viewer — Toggle Auto-Step"
      }
    ],
    "languages": [
      {
        "id": "f-flat-minor",
        "aliases": ["F♭m", "f-flat-minor", "ff", "ffp"],
        "extensions": [".ff", ".ffp"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "f-flat-minor",
        "scopeName": "source.f-flat-minor",
        "path": "./syntaxes/ff.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "F♭m Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/fbm-dark-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": ["meta.preprocessor.f-flat-minor"],
            "settings": {
              "foreground": "#808080",
              "fontStyle": "italic"
            }
          },
          {
            "scope": ["meta.compiler.annotation.f-flat-minor"],
            "settings": {
              "foreground": "#808080"
            }
          },
          {
            "comment": "JSDoc-style: the whole effect comment is subdued italic. Inner rules only tint foregrounds; fontStyle inherits from this parent rule.",
            "scope": ["comment.block.effect.f-flat-minor"],
            "settings": {
              "foreground": "#606060",
              "fontStyle": "italic"
            }
          },
          {
            "scope": ["comment.block.effect.f-flat-minor keyword.directive.effect.f-flat-minor"],
            "settings": {
              "foreground": "#7D6C43"
            }
          },
          {
            "scope": ["comment.block.effect.f-flat-minor entity.name.function.effect.f-flat-minor"],
            "settings": {
              "foreground": "#536E86"
            }
          },
          {
            "scope": [
              "comment.block.effect.f-flat-minor keyword.other.effect-clause.f-flat-minor",
              "comment.block.effect.f-flat-minor keyword.control.conditional.effect.f-flat-minor"
            ],
            "settings": {
              "foreground": "#676282"
            }
          },
          {
            "scope": ["comment.block.effect.f-flat-minor constant.language.error.effect.f-flat-minor"],
            "settings": {
              "foreground": "#845656"
            }
          },
          {
            "scope": ["comment.block.effect.f-flat-minor comment.note.effect.f-flat-minor"],
            "settings": {
              "foreground": "#536053"
            }
          },
          {
            "scope": [
              "comment.block.effect.f-flat-minor variable.other.effect.f-flat-minor",
              "comment.block.effect.f-flat-minor variable.other.rest.effect.f-flat-minor",
              "comment.block.effect.f-flat-minor variable.other.rest-length.effect.f-flat-minor"
            ],
            "settings": {
              "foreground": "#5E7383"
            }
          },
          {
            "scope": [
              "comment.block.effect.f-flat-minor keyword.operator.effect-separator.f-flat-minor",
              "comment.block.effect.f-flat-minor keyword.operator.f-flat-minor",
              "comment.block.effect.f-flat-minor punctuation.definition.quote.begin.f-flat-minor",
              "comment.block.effect.f-flat-minor punctuation.definition.quote.end.f-flat-minor"
            ],
            "settings": {
              "foreground": "#606060"
            }
          },
          {
            "scope": ["comment.block.effect.f-flat-minor constant.numeric.f-flat-minor"],
            "settings": {
              "foreground": "#697662"
            }
          },
          {
            "scope": ["comment.block.effect.f-flat-minor support.function.effect.f-flat-minor"],
            "settings": {
              "foreground": "#6D6954"
            }
          },
          {
            "scope": ["comment.block.effect.f-flat-minor constant.language.empty-stack.effect.f-flat-minor"],
            "settings": {
              "foreground": "#606D60"
            }
          }
        ]
      }
    }
  }
}
