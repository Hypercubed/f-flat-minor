.import ../core/core.ff
.import ./atanh.ffp

/* @lean
theorem ilog2_base (N : Int) (h0 : 0 <= N) (h : N < 2) : ilog2 N = 0 := by
  rw [ilog2_unfold N h0]
  simp [h]
theorem ilog2_step (N : Int) (h0 : 0 <= N) (h : 1 < N) : ilog2 N = ilog2 (shr N 1) + 1 := by
  rw [ilog2_unfold N h0]
  have hc : ¬ N < 2 := by omega
  simp [hc]
theorem ilog10_base (N : Int) (h0 : 0 <= N) (h : N < 10) : ilog10 N = 0 := by
  rw [ilog10_unfold N h0]
  simp [h]
