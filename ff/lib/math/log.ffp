*/

__n: 20 ; /* @effect __n: == 20 */ /* number of digits to use for fixed-point calculations */
__s: 100000000000000000000 ; /* @effect __s: == 100000000000000000000 */ /* 10^n */
__ln2: 69314718055994530941 ; /* @effect __ln2: == 69314718055994530941 */ /* ⌊ln(2)*10^n⌋ */

nln2:
  ++
  3 atanh-inv
  2 *
  10 /
; /* n nln2 == ⌊10^n*ln(2)⌋ */

ilb: dup 1 > [ 1 >> ilb ++ ] [ drop 0 ] branch ; /* x ilb == ⌊log2(x)⌋ */ /* @effect ilb: N == M requires 0 <= N ensures M = ilog2(N) @by-induction N >> 1 */
ilog: dup 10 >= [ 10 / ilog ++ ] [ drop 0 ] branch ; /* x ilog == ⌊log10(x)⌋ */ /* @effect ilog: N == M requires 0 <= N ensures M = ilog10(N) @by-induction N / 10 */
iln: ilb __ln2 * __s / ; /* -effect iln: X == M ensures M = __ln2*ilb(X)/__s (PARKED: callee ilb is directly self-recursive with no @effect; wrapper-lifting blocked until ilb proves) */ /* x iln == ⌊ln(x)⌋ */
