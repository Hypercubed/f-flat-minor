__u2_newp: /* u² p q odd v² */
  [ atan_shared_over3 ] dip /* u² q*v²-p*odd*u² v² */
  dup
  [ [ dig [ * * ] dip ] dip * swap - ] dip /* u² q*v²+p*odd*u² v² */
; /* u² p q odd v² __u2_newp == u² p' v² */

__tail_loop:
  over positive?
  [
    over
    2 -
    [atan_shared_newq_stack] dip
    swapd
    [__u2_newp] dipd
    dig
    __tail_loop
  ]
  [
    drop2
    [nip] dip
  ]
  branch
; /* u v u2 p q odd v2 __tail_loop == u v p q */ /* PARKED(@by-induction countdown by 2 on ODD): recursive-arm composer doom-loop, see tasks 2.1; model tailP/tailQ kept in @lean above for resume */

__parts:
  atan_shared_odd_from_precision
  atan_shared_seed_taylor_state
  __tail_loop
  atan_shared_scale_tail_result
; /* n u v __parts == p q */

_atan__core_scaled:
  rot
  dup
  [ rot __parts ] dip
  p/q*S
; /* n u v _atan__core_scaled == ⌊10^n*atan(u/v)⌋ for reduced positive ratios */

_atan__needs_pi4:
  dup2 + sqr bury sqr 2 * bury drop swap >
; /* @effect _atan__needs_pi4: U V == (U+V)^2>2*V^2 */ /* u v _atan__needs_pi4 == u/v > tan(pi/8) for positive u <= v */
