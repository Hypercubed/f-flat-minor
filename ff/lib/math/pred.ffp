.import ../core/core.ff

/* Predicates */

negitive?: 0 < ; /* @effect negitive?: N == N<0 */
positive?: 0 > ; /* @effect positive?: N == 0<N */
divisor?: % zero? ; .inline /* @effect divisor?: N D == (N%D)=0 requires D!=0 */
even?: 2 divisor? ; .inline /* @effect even?: N == (N%2)=0 */
odd?: even? not ; .inline /* @effect odd?: N == (N%2)!=0 */
