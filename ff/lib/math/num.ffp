*/

!: dup [ dup -- ! * ] [ drop 1 ] branch ; /* @effect !: N == M requires 0 <= N ensures M = fact(N)
   @by-induction N - 1 */
nck: dup2 - ! swap ! * [ ! ] dip / ; /* @effect nck: N K == C requires 0 <= K ∧ K <= N ensures C = fact(N)/(fact(K)*fact(N-K)) */ /* n k nck == C(n,k) */

/* Knuth operators */

^^: -- dup [ [ dup ] swap times [ ^ ] ] dip times ; /* -effect ^^: A B == T (tetration A^^B; PARKED: hyperoperation spec inexpressible in effect expr language; nested-times higher-order composition beyond composer) */
^^^: -- dup [ [ dup ] swap times [ ^^ ] ] dip times ; /* -effect ^^^: A B == P (pentation A^^^B; PARKED: hyperoperation spec inexpressible in effect expr language; nested-times higher-order composition beyond composer) */
