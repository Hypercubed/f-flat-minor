/* New-syntax effect annotations (Nov 20, 2026) sit above each
   definition, next to the existing old-syntax comment (kept for
   now). The @effect tag is read by the Lean generator; the plain
   effect tag (no @) is a statement the generator skips until
   Phase 8 (quotations). Recursive definitions are not annotated:
   their effects need @rec-effect + @induction. */

/* constants 1 2 3 */
true: 1 ; /* @effect true: == 1 */
false: 0 ; /* @effect false: == 0 */

/* incrementors */
--: 1 - ; /* @effect --: N == N-1 */
++: 1 + ; /* @effect ++: N == N+1 */
pred: dup -- ; /* @effect pred: N == N N-1 */
succ: dup ++ ; /* @effect succ: N == N N+1 */

/* DIP words */
/* Semantic anchors: slip/swap/dupd are foundational contracts.
 * Routine ERS cleanup should not rewrite these definitions unless explicitly requested.
 * Wrapper definitions like `x: q< Y q> ;` are irreducible as definitions.
 * Outside defining wrappers, ERS may replace `q< Y q>` with the named word when available. */

slip: q< eval q> ; /* @effect slip: ..R [..R -- ..S] B == ..S B */
swapd: q< swap q> ; /* @effect swapd: A B C == B A C */
dupd: q< dup q> ; /* @effect dupd: A B == A A B */

/* shuffle words */

drop2: drop drop ; /* @effect drop2: A B == */
dip: swap slip ; .inline /* @effect dip: ..R A [..R -- ..S] == ..S A */
dipd: swap [dip] dip ; .inline /* @effect dipd: ..R A B [..R -- ..S] == ..S A B */
dig: swapd swap ; .inline /* @effect dig: A B C == B C A */
bury: swap swapd ; .inline /* @effect bury: A B C == C A B */
rot: bury swap ; .inline /* @effect rot: A B C == C B A */
over: dupd swap ; .inline /* @effect over: A B == A B A */
dup2: over over ; .inline /* @effect dup2: A B == A B A B */
run: dup slip ; .inline /* @effect run: ..R [..R -- ..S] == ..S [..R -- ..S] */

nip: swap drop ; .inline /* @effect nip: A B == B */

tuck: swap over ; .inline /* @effect tuck: A B == B A B */

sip: over slip ; .inline /* @effect sip: ..R A [..R A -- ..S] == ..S A */
sipd: [sip] dip ; .inline /* @effect sipd: ..R A [..R A -- ..S] C == ..S A C */
bi: sipd dig slip swap ; .inline /* @effect bi: ..R A [..R A --..S] [..R A --..T] ==..S ..T */
bi2: [ [dup2] dip eval bury ] dip eval ; .inline /* @effect bi2: ..R A B [..R A B --..S] [..R A B --..T] ==..S ..T */

/* inquisitive */
zero?: 0 = ; /* @effect zero?: N == N=0 */
not: zero? ; .inline /* @effect not: F == F=0 */
nz?: zero? not ; .inline /* @effect nz?: N == N!=0 */
truthy?: nz? ; .inline /* @effect truthy?: N == N!=0 */
falsey?: zero? ; .inline /* @effect falsey?: N == N=0 */
!=: = not ; .inline /* @effect !=: A B == A!=B */

/* comparison */
<=: > not ; .inline /* @effect <=: A B == F ensures F = if A > B then 0 else 1 */
>=: < not ; .inline /* @effect >=: A B == F ensures F = if A < B then 0 else 1 */

sort2: dup2 > [swap] ? ; .inline /* @effect sort2: A B == X Y ensures X = if A < B then A else B ∧ Y = if A < B then B else A */
/* @effect between?: LO HI N == F ensures F = if LO < HI then (if LO < N ∧ N < HI then 1 else 0) else (if HI < N ∧ N < LO then 1 else 0) */
between?: [sort2] dip swap dupd < bury < and ; .inline /* lo hi n between? == flag */

/* binary operators */
bxor: dup2 ~ & rot ~ & | ; /* @effect bxor: A B == A⊕B */

/* logical */
and: * truthy? ; /* @effect and: A B == A*B!=0 */
or: + truthy? ; /* @effect or: A B == A+B!=0 */
nand: * zero? ; /* @effect nand: A B == A*B=0 */
nor: + zero? ; /* @effect nor: A B == A+B=0 */

/* short circuit */
or_else: [ sip swap ] dip swap [ drop2 true ] [eval] branch ; .inline /* @effect or_else: ..R A [..R A -- B] [..R A -- C] ==..R F ensures F = if B != 0 then 1 else C */
and_also: [ sip swap ] dip swap [eval] [ drop2 false ] branch ; .inline /* @effect and_also: ..R A [..R A -- B] [..R A -- C] ==..R F ensures F = if B != 0 then C else 0 */

/* branching */
choose: rot [ swap ] ? drop ; .inline  /* @effect choose: F A B == X ensures X = if F != 0 then A else B */
/* @effect branch: ..R F [..R -- ..S] [..R -- ..T] == ..S requires F != 0 */
/* @effect branch: ..R F [..R -- ..S] [..R -- ..T] == ..T requires F == 0 */
branch: choose eval ; .inline

/* stack */
empty?: depth zero? ; /* @effect empty?: ..R == ..R #R=0 */
pushtop: depth 1 > [ swap [pushtop] dip ] ? ; /* @effect pushtop: ..R A == A ..R @by-induction R.length */

/* counters */

_loop: dup [ -- [ dup slip ] dip _loop ] ? ; /* @effect _loop: A [X -- F X] N == iterates(F,N,A) [X -- F X] 0 when 0 <= N @by-induction N - 1 */
loop: _loop drop ; /* @effect loop: A [X -- F X] N == iterates(F,N,A) [X -- F X] when 0 <= N */

times: loop drop ; /* @effect times: A [X -- F X] N == iterates(F,N,A) when 0 <= N */
seq: swap times ; /* @effect seq: A N [X -- F X] == iterates(F,N,A) when 0 <= N */

range: over - [succ] seq ; /* @effect range: A B == intRange(A,B+1) when 0 <= B - A @by-proof have hBA : ((B - A).toNat : Int) = B - A := Int.toNat_of_nonneg hw; have hAdd : A + (B - A) = B := (by omega); fbm_verify [rangeProg, over_effect, dupd_effect, succ_effect, inc_effect, seq_effect, times_effect, loop_effect, _loop_effect] */
count: 0 swap ++ [succ] seq drop ; /* @effect count: N == intRange(0,N+1) when 0 <= N @by-proof have hN : (N + 1).toNat = N.toNat + 1 := (by omega); have hcast : ((N.toNat : Int)) = N := Int.toNat_of_nonneg hw; simp_all; fbm_verify [countProg, inc_effect, succ_effect, seq_effect, times_effect, loop_effect, _loop_effect] */
