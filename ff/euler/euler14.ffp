.import <prelude>

/* http://projecteuler.net/index.php?section=problems&id=14 */

_odd?: 1 & ; .inline
2/: 1 >> ; .inline

next-collatz: dup _odd? [ 3 * 1 + 2/ [ 2 + ] dip ] [ 2/ q< ++ q> ] branch ; .inline
collatz: dup 1 > [ next-collatz collatz ] ? ;
collatz-count: 0 swap collatz drop ;

runn:
  /* Skip n = 4k+1 if 1.5n+0.5 is in range (< 1M) */
  dup 4 % 1 = [ dup 666666 swap < ] [ true ] branch
  [
    dup collatz-count
    q< over q>
    dup q< < q> swap
    [ q< q< drop2 q> q> over ]
    [drop]
    branch
  ] ?
;

step: dup 1_000_000 < [ runn 2 + step ] ? ;

500000 0 
over ++
step
drop drop .